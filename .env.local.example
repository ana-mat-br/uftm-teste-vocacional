# Copie este arquivo pra .env.local e preencha com as keys reais.
# .env.local NUNCA deve ser commitado (já está no .gitignore).

# === Anthropic (Claude Haiku 4.5) ===
# Pegue em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# === Supabase ===
# Pegue em https://supabase.com/dashboard → seu projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

# === App ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000
