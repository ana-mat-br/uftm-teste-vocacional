# Copie este arquivo pra .env.local e preencha com as keys reais.
# .env.local NUNCA deve ser commitado (já está no .gitignore).

# === Supabase (novo formato de keys, 2025+) ===
# Pegue em https://supabase.com/dashboard/project/SEU_PROJETO/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# === Anthropic (Claude Haiku 4.5) ===
# Pegue em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# === App ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000
